{
  "name": "terrain-detail-studio-backend",
  "version": "1.0.0",
  "description": "Vercel API Gateway & Neon Database Schema for Terrain Detail Studio",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.4",
    "@hono/node-server": "^1.11.1",
    "hono": "^4.4.7",
    "drizzle-orm": "^0.31.2",
    "jose": "^5.6.3",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "drizzle-kit": "^0.22.7",
    "typescript": "^5.5.2",
    "tsx": "^4.16.0"
  }
}
